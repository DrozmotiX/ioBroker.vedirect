{
  "name": "iobroker.vedirect",
  "version": "0.3.3",
  "description": "Robust read-only VE.Direct data from Victron devices",
  "author": {
    "name": "DutchmanNL",
    "email": "rdrozda@hotmail.com"
  },
  "contributors": [
    {
      "name": "Andiling"
    },
    {
      "name": "joerg"
    }
  ],
  "homepage": "https://github.com/joergspoerl/ioBroker.vedirect",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "energy",
    "connection",
    "pv",
    "solar",
    "victron"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/joergspoerl/ioBroker.vedirect"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.1",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.20.5",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "mocha": "^11.8.0",
    "proxyquire": "^2.1.3",
    "sinon": "^22.1.0",
    "sinon-chai": "^3.7.0",
    "typescript": "~5.9.3"
  },
  "files": [
    "admin/",
    "lib/",
    "docs/",
    "main.js",
    "io-package.json",
    "LICENSE"
  ],
  "main": "main.js",
  "scripts": {
    "test:js": "mocha",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "test:all": "npm test && npm run check && npm run lint && npm run test:integration",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "release-script --all --branchPattern '*'",
    "release-dry": "release-script --all --dry",
    "translate": "translate-adapter",
    "build": "echo 'No build required - pure JavaScript project'"
  },
  "overrides": {
    "mocha": {
      "glob": "14.0.6",
      "minimatch": "11.0.9",
      "diff": "8.0.3",
      "serialize-javascript": "7.1.4"
    },
    "@alcalzone/esbuild-register": {
      "esbuild": "0.27.2"
    },
    "@iobroker/adapter-dev": {
      "rimraf": "6.1.4"
    },
    "google-gax": {
      "rimraf": "6.1.4"
    },
    "@eslint/eslintrc": {
      "minimatch": {
        "brace-expansion": "1.1.21"
      }
    },
    "zod": "4.6.7"
  },
  "bugs": {
    "url": "https://github.com/joergspoerl/ioBroker.vedirect/issues"
  },
  "readmeFilename": "README.md"
}
